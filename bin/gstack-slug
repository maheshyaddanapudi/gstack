#!/usr/bin/env bash
# gstack-slug — output project slug and sanitized branch name
# Usage: eval "$(gstack-slug)"  → sets SLUG and BRANCH variables
# Or:    gstack-slug            → prints SLUG=... and BRANCH=... lines
#
# Security: output is sanitized to [a-zA-Z0-9._-] only, preventing
# shell injection when consumed via source or eval.
set -euo pipefail
# `git remote get-url origin` exits non-zero when there is no `origin` remote
# (local-only repos, freshly `git init`ed repos). Under `set -o pipefail` that
# status propagates through the pipe and, combined with `set -e`, would abort the
# whole script — printing nothing and breaking `eval "$(gstack-slug)"` consumers.
# Tolerate the failure with `|| true` so we degrade gracefully instead of crashing.
RAW_SLUG=$(git remote get-url origin 2>/dev/null | sed 's|.*[:/]\([^/]*/[^/]*\)\.git$|\1|;s|.*[:/]\([^/]*/[^/]*\)$|\1|' | tr '/' '-' || true)
# No remote? Fall back to the repo's top-level directory name so local-only repos
# still get a stable, non-empty, non-colliding slug instead of an empty one.
if [ -z "$RAW_SLUG" ]; then
  TOPLEVEL=$(git rev-parse --show-toplevel 2>/dev/null || true)
  [ -n "$TOPLEVEL" ] && RAW_SLUG=$(basename "$TOPLEVEL")
fi
RAW_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null | tr '/' '-' || true)
# Strip any characters that aren't alphanumeric, dot, hyphen, or underscore
SLUG=$(printf '%s' "$RAW_SLUG" | tr -cd 'a-zA-Z0-9._-')
BRANCH=$(printf '%s' "$RAW_BRANCH" | tr -cd 'a-zA-Z0-9._-')
echo "SLUG=$SLUG"
echo "BRANCH=$BRANCH"
