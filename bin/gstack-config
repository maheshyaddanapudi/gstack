#!/usr/bin/env bash
# gstack-config — read/write ~/.gstack/config.yaml
#
# Usage:
#   gstack-config get <key>          — read a config value
#   gstack-config set <key> <value>  — write a config value
#   gstack-config list               — show all config
#
# Env overrides (for testing):
#   GSTACK_STATE_DIR  — override ~/.gstack state directory
set -euo pipefail

STATE_DIR="${GSTACK_STATE_DIR:-$HOME/.gstack}"
CONFIG_FILE="$STATE_DIR/config.yaml"

case "${1:-}" in
  get)
    KEY="${2:?Usage: gstack-config get <key>}"
    # Everything after the first colon, trimmed. `cut -f2-` rejoins later fields
    # with ':' so URL values (http://host:port) survive, and we only trim the
    # ends — the old `awk '{print $2}'` returned just the first token, truncating
    # any spaced value like "[2, 3]" to "[2,".
    grep -E "^${KEY}:" "$CONFIG_FILE" 2>/dev/null | tail -1 \
      | cut -d: -f2- | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' || true
    ;;
  set)
    KEY="${2:?Usage: gstack-config set <key> <value>}"
    VALUE="${3:?Usage: gstack-config set <key> <value>}"
    mkdir -p "$STATE_DIR"
    if grep -qE "^${KEY}:" "$CONFIG_FILE" 2>/dev/null; then
      # Rewrite the key's line with awk (portable) instead of `sed -i ''`, which
      # is BSD-only — on GNU sed the empty '' is read as the script and the real
      # expression becomes a filename, so the update silently fails (exit 2).
      # awk -v also passes VALUE literally, so URLs with '/' and ':' are safe
      # (the old sed used '/' as its delimiter and would mangle them).
      awk -v key="$KEY" -v val="$VALUE" '
        $0 ~ "^" key ":" { print key ": " val; next }
        { print }
      ' "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
    else
      echo "${KEY}: ${VALUE}" >> "$CONFIG_FILE"
    fi
    ;;
  list)
    cat "$CONFIG_FILE" 2>/dev/null || true
    ;;
  *)
    echo "Usage: gstack-config {get|set|list} [key] [value]"
    exit 1
    ;;
esac
